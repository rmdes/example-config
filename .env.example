# Copy this file to `.env` and replace the values below.
# `.env` is git-ignored — never commit real secrets.

# Your website’s URL, e.g. https://example.com
PUBLICATION_URL=

# A long random string used to generate access tokens and passwords.
# Generate one with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SECRET=

# Leave blank on first run. Start the server, visit /auth/new-password,
# enter your chosen password, then paste the generated value here.
PASSWORD_SECRET=

# GitHub content store
GITHUB_USER=
GITHUB_REPO=
GITHUB_BRANCH=
GITHUB_TOKEN=

# Mastodon syndicator
MASTODON_URL=
MASTODON_USER=
MASTODON_ACCESS_TOKEN=

# Docker Compose only — credentials for the bundled MongoDB container.
# Not needed if you set MONGO_URL to an external database instead.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=

# Point Indiekit at a database. The bundled container is reachable at
# `mongo` from inside Compose, and on localhost:27018 from the host.
# Each starter overrides the database name — see STARTERS.md.
MONGO_URL=

# Port Indiekit is published on. Defaults to 3000.
HTTP_PORT=3000

# Run the containers as you, so posts and uploads written into the
# bind-mounted repositories stay editable by your own user.
#   HOST_UID=$(id -u)   HOST_GID=$(id -g)
# Leave these unset and Compose resolves `user:` to ":", which silently
# means root — on rootful Docker your content ends up root-owned.
HOST_UID=1000
HOST_GID=1000
