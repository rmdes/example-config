#!/usr/bin/env bash
# Point this stack at one of the SSG starters (or back at the local scaffold).
#
#   ./use-starter hugo        # getindiekit/hugo-starter
#   ./use-starter eleventy    # getindiekit/eleventy-starter
#   ./use-starter jekyll      # getindiekit/jekyll-starter
#   ./use-starter local       # this repo's own ./eleventy scaffold
#   ./use-starter             # show which is active
set -euo pipefail
cd "$(dirname "$0")"

active() {
  head -1 docker-compose.override.yml 2>/dev/null | sed 's|^# *||'
}

if [ $# -eq 0 ]; then
  echo "active: $(active)"
  echo "available: $(ls starters/*.yml | xargs -n1 basename | sed 's/\.yml//' | tr '\n' ' ')"
  exit 0
fi

name=$1
src="starters/${name}.yml"
[ -f "$src" ] || { echo "No such starter: $name (have: $(ls starters/*.yml | xargs -n1 basename | sed 's/\.yml//' | tr '\n' ' '))" >&2; exit 1; }

# The repo each starter mounts must exist, and Indiekit needs its store dirs
# present before the container starts or Docker creates them as root.
case "$name" in
  eleventy) repo=../indiekit-eleventy-starter; mkdir -p "$repo/content" ;;
  hugo)     repo=../indiekit-hugo-starter;     mkdir -p "$repo/content" "$repo/static" ;;
  jekyll)   repo=../indiekit-jekyll-starter
            # node_modules is masked by an anonymous volume in the fragment
            # (host glibc vs container musl), and Docker creates the mount
            # point as root if it is absent -- which then breaks a later
            # `npm install` in the repo. Same trap as the store dirs above.
            mkdir -p "$repo" "$repo/node_modules"
            # A fresh named volume is root-owned, but the containers run as the
            # host user, so `gem install` into it fails with EACCES. Chown it
            # once, before compose brings the site service up.
            docker volume create jekyll-gems >/dev/null
            docker run --rm -u root -v jekyll-gems:/gems ruby:3.3 \
              chown "${HOST_UID:-$(id -u)}:${HOST_GID:-$(id -g)}" /gems ;;
    # Posts live here, not in the theme: the theme's content/ is its Eleventy
    # source too. Each directory is mounted into the theme separately, and has
    # to exist first or Docker creates it owned by root.
  reference-theme) repo=../indiekit-theme-eleventy-reference
                   mkdir -p content/{articles,bookmarks,likes,notes,photos,replies,media} ;;
  local)    repo=. ;;
esac
[ -d "$repo" ] || { echo "Missing repo for $name: $repo" >&2; exit 1; }

# --remove-orphans matters: the service is named `site` in the starter files but
# `eleventy` in the local one, so the previous container would otherwise linger
# and keep holding port 8080.
docker compose down --remove-orphans >/dev/null 2>&1 || true
cp "$src" docker-compose.override.yml
docker compose up -d

echo
echo "active: $(active)"
echo "  Indiekit : http://localhost:3000"
echo "  Site     : http://localhost:8080"
echo
echo "Open Indiekit on localhost (not 127.0.0.1) — it latches its hostname from"
echo "the first request it receives (getindiekit/indiekit#906)."
